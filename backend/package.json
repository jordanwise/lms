{
  "name": "lms-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "PATH=\"$PATH:./node_modules/.bin\" sam build",
    "start": "./scripts/start-local.sh",
    "start:full": "./scripts/start-local.sh --full",
    "dev-server": "tsx scripts/dev-server.ts",
    "local:db": "docker-compose up -d",
    "local:setup": "./scripts/setup-local.sh",
    "local:seed": "./scripts/seed-data.sh",
    "local:reset": "./scripts/reset-db.sh",
    "local:api": "PATH=\"$PATH:./node_modules/.bin\" sam local start-api --docker-network lms-net --env-vars env.local.json --skip-pull-image",
    "local:invoke": "sam local invoke --docker-network lms-net --env-vars env.local.json",
    "deploy": "sam deploy --guided",
    "pretest": "./scripts/ensure-localstack.sh",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --detectOpenHandles --testTimeout=30000",
    "test:api": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testPathPatterns='api.test'",
    "test:state": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testPathPatterns='stateMachine.test'",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testPathPatterns='gameLifecycle.test'",
    "test:tick": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testPathPatterns='tick.test'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
